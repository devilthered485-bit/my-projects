
#include <stdio.h>

int main()
{
    int a, b, temp;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    printf("\nBefore swapping:");
    printf("\na = %d, b = %d", a, b);

    temp = a;
    a = b;
    b = temp;

    printf("\n\nAfter swapping:");
    printf("\na = %d, b = %d", a, b);

    return 0;
}
